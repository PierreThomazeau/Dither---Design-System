      "control": 16,
      "surface": 16,
      "surface-lg": 20,
      "xl": 24,
      "2xl": 28,
      "3xl": 32,
      "4xl": 40
    },
    "gap": {
      "none": 0,
      "hairline": 1,
      "2xs": 2,
      "xs": 4,
      "sm": 6,
      "md": 8,
      "control": 10,
      "base": 12,
      "base-plus": 14,
      "lg": 16,
      "lg-plus": 20,
      "xl": 24,
      "2xl": 32,
      "3xl": 36,
      "section": 40,
      "4xl": 48,
      "5xl": 64
