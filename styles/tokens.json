  "shadow": {
    "2xs": "0 1px 0 0 rgb(0 0 0 / 5%)",
    "xs": "0 1px 2px 0 rgb(0 0 0 / 5%)",
    "sm": "0 1px 3px 0 rgb(0 0 0 / 10%), 0 1px 2px -1px rgb(0 0 0 / 10%)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 10%), 0 2px 4px -2px rgb(0 0 0 / 10%)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%)",
    "xl": "0 20px 25px -5px rgb(0 0 0 / 10%), 0 8px 10px -6px rgb(0 0 0 / 10%)",
    "2xl": "0 25px 50px -12px rgb(0 0 0 / 25%)",
    "popover": "0 4px 6px -1px rgb(0 0 0 / 10%), 0 2px 4px -2px rgb(0 0 0 / 10%)",
    "tabs-active": "0 1px 3px 0 rgb(0 0 0 / 10%), 0 1px 2px -1px rgb(0 0 0 / 10%)",
    "chart-tooltip": "0 20px 25px -5px rgb(0 0 0 / 10%), 0 8px 10px -6px rgb(0 0 0 / 10%)",
    "button-primary": "inset 0 0 0 1px rgb(255 255 255 / 12%), inset 0 -2px 1.2px 0 rgb(0 0 0 / 40%), inset 0 2px 1px 0 rgb(255 255 255 / 15%), inset 0 0 0 1px #131313",
    "button-primary-pressed": "inset 0 0 0 1px rgb(255 255 255 / 12%), inset 0 1px 2px 0 rgb(0 0 0 / 35%)",
    "focus": "0 0 0 3px rgb(163 163 163 / 50%)",
    "focus-destructive": "0 0 0 3px rgb(220 40 40 / 40%)"
  },
  "blur": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 40,
    "3xl": 64
  },
  "dither": {
    "cell": 6,
    "dot": 2,
    "offsetRowsBy": 3,
    "color": "var(--border-strong)",
    "variants": {
      "regular": "2px dots / 6px grid, odd rows offset 3px",
      "fine": "1.5px dots / 4px grid, odd rows offset 2px",
      "bayer": "4x4 Bayer ordered dither, 4px cells, threshold 0.32",
      "gradient": "4x4 Bayer, density fades 0.68 -> 0.06 top to bottom"
    }
  }
